# ============================================
# TG Bot "Твой психолог" 🧠
# Переменные окружения
# ============================================

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token

# PostgreSQL (для локальной разработки)
DATABASE_URL=postgresql://botuser:botpassword@localhost:5432/psychobot

# Redis (для локальной разработки)
REDIS_URL=redis://localhost:6379/0

# Путь к ML-модели (в Docker: /models/...)
MODEL_PATH=/models/YandexGPT-5-Lite-8B-instruct-Q4_K_M.gguf

# Модель анализа тональности (Hugging Face)
SENTIMENT_MODEL=blanchefort/rubert-base-cased-sentiment